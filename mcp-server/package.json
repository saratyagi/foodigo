{
  "name": "foodigo-mcp-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "tunnel": "ngrok start foodigo-mcp",
    "dev:tunnel": "concurrently --kill-others-on-fail \"npm run dev\" \"npm run tunnel\"",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
